# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public Site URL (Used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://kaamhogaya.pk

# Google Analytics 4 (Optional - leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# WhatsApp Document Check CTA (Optional - defaults to 923000000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000
